# Public application URL used for metadata and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Create these values only after a Supabase project is explicitly approved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public browser token. Restrict it by allowed URLs in Mapbox before use.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
